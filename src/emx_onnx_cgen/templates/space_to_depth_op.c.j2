EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
    for (idx_t n = 0; n < {{ batch }}; ++n) {
        for (idx_t c_in = 0; c_in < {{ in_channels }}; ++c_in) {
            for (idx_t offset_h = 0; offset_h < {{ blocksize }}; ++offset_h) {
                for (idx_t offset_w = 0; offset_w < {{ blocksize }}; ++offset_w) {
{% if mode == "DCR" %}
                    idx_t c_out = (offset_h * {{ blocksize }} + offset_w) * {{ in_channels }} + c_in;
{% else %}
                    idx_t c_out = (c_in * {{ blocksize }} + offset_h) * {{ blocksize }} + offset_w;
{% endif %}
                    for (idx_t h_out = 0; h_out < {{ out_h }}; ++h_out) {
                        for (idx_t w_out = 0; w_out < {{ out_w }}; ++w_out) {
                            {{ output }}[n][c_out][h_out][w_out] = {{ input0 }}[n][c_in][h_out * {{ blocksize }} + offset_h][w_out * {{ blocksize }} + offset_w];
                        }
                    }
                }
            }
        }
    }
}
