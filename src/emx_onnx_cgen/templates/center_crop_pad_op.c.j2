{% import "axis_loops.c.j2" as axis_loops %}
EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
{% call axis_loops.loops(out_loop_vars, output_shape) %}
int in_bounds = 1;
{% for i in range(output_shape | length) %}
const idx_t in_{{ i }} = (idx_t){{ out_loop_vars[i] }} - (idx_t){{ pad_starts[i] }} + (idx_t){{ crop_starts[i] }};
if (in_{{ i }} < 0 || in_{{ i }} >= (idx_t){{ input_shape[i] }}) {
    in_bounds = 0;
}
{% endfor %}
{{ output }}{% for var in out_loop_vars %}[{{ var }}]{% endfor %} = in_bounds ? {{ input0 }}{% for i in range(output_shape | length) %}[in_{{ i }}]{% endfor %} : ({{ c_type }})0;
{% endcall %}
}
