EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
    const {{ c_type }} sqrt_scale = {{ sqrt_scale_literal }};
    const {{ c_type }} softcap = {{ softcap_literal }};
    {% if output_present_key %}
    for (int b = 0; b < {{ batch }}; ++b) {
        for (int h = 0; h < {{ kv_heads }}; ++h) {
            for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                if (ki < {{ past_seq }}) {
                    for (int d = 0; d < {{ qk_head_size }}; ++d) {
                        {{ output_present_key }}[b][h][ki][d] = {{ input_past_key }}[b][h][ki][d];
                    }
                } else {
                    int k_index = ki - {{ past_seq }};
                    for (int d = 0; d < {{ qk_head_size }}; ++d) {
                        {% if k_rank == 4 %}
                        {{ output_present_key }}[b][h][ki][d] = {{ input_k }}[b][h][k_index][d];
                        {% else %}
                        {{ output_present_key }}[b][h][ki][d] = {{ input_k }}[b][k_index][h * {{ qk_head_size }} + d];
                        {% endif %}
                    }
                }
            }
        }
    }
    {% endif %}
    {% if output_present_value %}
    for (int b = 0; b < {{ batch }}; ++b) {
        for (int h = 0; h < {{ kv_heads }}; ++h) {
            for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                if (ki < {{ past_seq }}) {
                    for (int d = 0; d < {{ v_head_size }}; ++d) {
                        {{ output_present_value }}[b][h][ki][d] = {{ input_past_value }}[b][h][ki][d];
                    }
                } else {
                    int v_index = ki - {{ past_seq }};
                    for (int d = 0; d < {{ v_head_size }}; ++d) {
                        {% if v_rank == 4 %}
                        {{ output_present_value }}[b][h][ki][d] = {{ input_v }}[b][h][v_index][d];
                        {% else %}
                        {{ output_present_value }}[b][h][ki][d] = {{ input_v }}[b][v_index][h * {{ v_head_size }} + d];
                        {% endif %}
                    }
                }
            }
        }
    }
    {% endif %}
    {% set uses_offset = is_causal or left_window_size >= 0 or right_window_size >= 0 %}
    for (int b = 0; b < {{ batch }}; ++b) {
        {% if not uses_offset %}
        {% elif input_nonpad_kv_seqlen and not input_past_key %}
        /* External cache: the query block ends at the last valid key. */
        const int64_t offset = {{ input_nonpad_kv_seqlen }}[b] - {{ q_seq }};
        {% else %}
        const int64_t offset = {{ past_seq }};
        {% endif %}
        for (int h = 0; h < {{ q_heads }}; ++h) {
            int kv_head = h / {{ head_group_size }};
            for (int qi = 0; qi < {{ q_seq }}; ++qi) {
                {{ c_type }} q_scaled[{{ qk_head_size }}];
                for (int d = 0; d < {{ qk_head_size }}; ++d) {
                    {% if q_rank == 4 %}
                    q_scaled[d] = {{ input_q }}[b][h][qi][d] * sqrt_scale;
                    {% else %}
                    q_scaled[d] = {{ input_q }}[b][qi][h * {{ qk_head_size }} + d] * sqrt_scale;
                    {% endif %}
                }
                {{ c_type }} scores[{{ total_seq }}];
                int row_attended = 0;
                for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                    {{ acc_type }} qk_acc = {{ acc_zero_literal }};
                    int k_index = ki - {{ past_seq }};
                    for (int d = 0; d < {{ qk_head_size }}; ++d) {
                        {{ c_type }} k_val;
                        {% if input_past_key %}
                        if (ki < {{ past_seq }}) {
                            k_val = {{ input_past_key }}[b][kv_head][ki][d];
                        } else {
                            {% if k_rank == 4 %}
                            k_val = {{ input_k }}[b][kv_head][k_index][d];
                            {% else %}
                            k_val = {{ input_k }}[b][k_index][kv_head * {{ qk_head_size }} + d];
                            {% endif %}
                        }
                        {% else %}
                        {% if k_rank == 4 %}
                        k_val = {{ input_k }}[b][kv_head][k_index][d];
                        {% else %}
                        k_val = {{ input_k }}[b][k_index][kv_head * {{ qk_head_size }} + d];
                        {% endif %}
                        {% endif %}
                        k_val = k_val * sqrt_scale;
                        qk_acc += {{ acc_cast }}q_scaled[d] * {{ acc_cast }}k_val;
                    }
                    {{ c_type }} score = {{ out_cast }}qk_acc;
                    {{ c_type }} bias = {{ zero_literal }};
                    {% if input_attn_mask %}
                    if (ki >= {{ mask_kv_seq }}) {
                        bias = {{ min_literal }};
                    } else {
                        {% if mask_is_bool %}
                        bias = {{ input_attn_mask }}{{ mask_index }} ? {{ zero_literal }} : {{ min_literal }};
                        {% else %}
                        bias = {{ input_attn_mask }}{{ mask_index }};
                        {% endif %}
                    }
                    {% endif %}
                    {% if is_causal %}
                    if (ki > qi + offset) {
                        bias = {{ min_literal }};
                    }
                    {% endif %}
                    {% if left_window_size >= 0 %}
                    if (qi + offset - ki > {{ left_window_size }}) {
                        bias = {{ min_literal }};
                    }
                    {% endif %}
                    {% if right_window_size >= 0 %}
                    if (ki - (qi + offset) > {{ right_window_size }}) {
                        bias = {{ min_literal }};
                    }
                    {% endif %}
                    {% if input_nonpad_kv_seqlen %}
                    if (ki >= {{ input_nonpad_kv_seqlen }}[b]) {
                        bias = {{ min_literal }};
                    }
                    {% endif %}
                    if (bias != {{ min_literal }}) {
                        row_attended = 1;
                    }
                    {{ c_type }} score_softcap = score;
                    if (softcap != {{ zero_literal }}) {
                        score_softcap = softcap * {{ scalar_fn(SF.TANH, dtype) }}(score / softcap);
                    }
                    {{ c_type }} score_bias = score_softcap + bias;
                    {% if output_qk_matmul %}
                    if ({{ qk_matmul_output_mode }} == 0) {
                        {{ output_qk_matmul }}[b][h][qi][ki] = score;
                    } else if ({{ qk_matmul_output_mode }} == 1) {
                        {{ output_qk_matmul }}[b][h][qi][ki] = score_softcap;
                    } else if ({{ qk_matmul_output_mode }} == 2) {
                        {{ output_qk_matmul }}[b][h][qi][ki] = score_bias;
                    }
                    {% endif %}
                    scores[ki] = score_bias;
                }
                {{ softmax_c_type }} max_score = {{ min_literal }};
                for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                    max_score = {{ scalar_fn(SF.MAXIMUM, softmax_dtype) }}(max_score, {{ softmax_cast }}scores[ki]);
                }
                if (max_score == {{ min_literal }}) {
                    max_score = {{ softmax_zero_literal }};
                }
                {{ softmax_c_type }} weights[{{ total_seq }}];
                {{ softmax_c_type }} sum = {{ softmax_zero_literal }};
                for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                    weights[ki] = {{ scalar_fn(SF.EXP, softmax_dtype) }}({{ softmax_cast }}scores[ki] - max_score);
                    sum += weights[ki];
                }
                if (sum == {{ softmax_zero_literal }}) {
                    sum = {{ softmax_one_literal }};
                }
                /* A query row without any attendable key yields zeros. */
                {{ c_type }} probs[{{ total_seq }}];
                for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                    probs[ki] = row_attended ? {{ probs_cast }}(weights[ki] / sum) : {{ zero_literal }};
                    {% if output_qk_matmul %}
                    if ({{ qk_matmul_output_mode }} == 3) {
                        {{ output_qk_matmul }}[b][h][qi][ki] = probs[ki];
                    }
                    {% endif %}
                }
                for (int vd = 0; vd < {{ v_head_size }}; ++vd) {
                    {{ acc_type }} acc = {{ acc_zero_literal }};
                    for (int ki = 0; ki < {{ total_seq }}; ++ki) {
                        {% if input_past_value %}
                        if (ki < {{ past_seq }}) {
                            acc += {{ acc_cast }}probs[ki] * {{ acc_cast }}{{ input_past_value }}[b][kv_head][ki][vd];
                        } else {
                            {% if v_rank == 4 %}
                            acc += {{ acc_cast }}probs[ki] * {{ acc_cast }}{{ input_v }}[b][kv_head][ki - {{ past_seq }}][vd];
                            {% else %}
                            acc += {{ acc_cast }}probs[ki] * {{ acc_cast }}{{ input_v }}[b][ki - {{ past_seq }}][kv_head * {{ v_head_size }} + vd];
                            {% endif %}
                        }
                        {% else %}
                        {% if v_rank == 4 %}
                        acc += {{ acc_cast }}probs[ki] * {{ acc_cast }}{{ input_v }}[b][kv_head][ki][vd];
                        {% else %}
                        acc += {{ acc_cast }}probs[ki] * {{ acc_cast }}{{ input_v }}[b][ki][kv_head * {{ v_head_size }} + vd];
                        {% endif %}
                        {% endif %}
                    }
                    {% if output_rank == 4 %}
                    {{ output }}[b][h][qi][vd] = {{ out_cast }}acc;
                    {% else %}
                    {{ output }}[b][qi][h * {{ v_head_size }} + vd] = {{ out_cast }}acc;
                    {% endif %}
                }
            }
        }
    }
}
