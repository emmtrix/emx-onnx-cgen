{% import "axis_loops.c.j2" as axis_loops %}
EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
    int64_t k = {{ k_value }};
    {% if k_input %}
    k = (int64_t){{ k_input }}[0];
    {% endif %}
{% call axis_loops.loops(batch_vars, batch_sizes) %}
for (idx_t row = 0; row < {{ rows }}; ++row) {
    for (idx_t col = 0; col < {{ cols }}; ++col) {
{% if upper %}
        {{ output }}{{ index }} = ((int64_t)col - (int64_t)row >= k) ? {{ input0 }}{{ index }} : {{ zero_literal }};
{% else %}
        {{ output }}{{ index }} = ((int64_t)row - (int64_t)col >= -k) ? {{ input0 }}{{ index }} : {{ zero_literal }};
{% endif %}
    }
}
{% endcall %}
}
