{% import "axis_loops.c.j2" as axis_loops %}
void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
    idx_t produced = 0;

    {% if axis_sizes %}
    const idx_t axis_sizes[] = { {% for axis_size in axis_sizes %}{{ axis_size }}{% if not loop.last %}, {% endif %}{% endfor %} };
    idx_t split_count = {{ axis_sizes | length }};
    {% elif split %}
    idx_t split_count = 0;
    {% if split_scalar %}
    idx_t scalar_split = (idx_t)({{ split }}[0]);
    if (scalar_split < 1) {
        scalar_split = 1;
    }
    split_count = ({{ axis_total }} + scalar_split - 1) / scalar_split;
    {% else %}
    split_count = {{ split_len }};
    {% endif %}
    {% else %}
    idx_t split_count = {{ axis_total }};
    {% endif %}

    if (split_count > EMX_SEQUENCE_MAX_LEN) {
        split_count = EMX_SEQUENCE_MAX_LEN;
    }

    idx_t axis_offset = 0;
    for (idx_t sequence_idx = 0; sequence_idx < split_count; ++sequence_idx) {
        idx_t chunk = 1;
        {% if axis_sizes %}
        chunk = axis_sizes[sequence_idx];
        {% elif split %}
        {% if split_scalar %}
        chunk = scalar_split;
        if (chunk > {{ axis_total }} - axis_offset) {
            chunk = {{ axis_total }} - axis_offset;
        }
        {% else %}
        chunk = (idx_t)({{ split }}[sequence_idx]);
        if (chunk < 0) {
            chunk = 0;
        }
        {% endif %}
        {% endif %}
        {% for dim in output_dim_arrays %}
        {{ dim.name }}[sequence_idx] = {{ dim.expr }};
        {% endfor %}
{% call axis_loops.loops(loop_vars, loop_sizes) %}
{{ output_sequence }}[sequence_idx]{{ output_index }} = {{ input0 }}{{ input_index }};
{% endcall %}
        axis_offset += chunk;
        produced += 1;
    }

    *{{ output_sequence }}__count = produced;
}
