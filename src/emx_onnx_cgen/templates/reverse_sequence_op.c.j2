{% import "axis_loops.c.j2" as axis_loops %}
EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
{% call axis_loops.loops(loop_vars, dims) %}
idx_t seq_len = (idx_t){{ sequence_lens }}[i{{ batch_axis }}];
if (seq_len < 0) {
    seq_len = 0;
}
if (seq_len > {{ dims[time_axis] }}) {
    seq_len = {{ dims[time_axis] }};
}
const idx_t source_time = i{{ time_axis }} < seq_len ? seq_len - 1 - i{{ time_axis }} : i{{ time_axis }};
{{ output }}{% for var in loop_vars %}[{{ var }}]{% endfor %} = {{ input0 }}{% for var in loop_vars %}[{{ "source_time" if loop.index0 == time_axis else var }}]{% endfor %};
{% endcall %}
}
