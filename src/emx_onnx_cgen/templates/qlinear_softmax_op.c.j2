{% import "axis_loops.c.j2" as axis_loops %}
{% macro dequantized(index) %}((({{ compute_type }})((int32_t){{ input0 }}{{ index }} - input_zero)) * input_scale_value){% endmacro %}
EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
    const {{ compute_type }} input_scale_value = ({{ compute_type }}){{ input_scale_expr }};
    const {{ compute_type }} output_scale_value = ({{ compute_type }}){{ output_scale_expr }};
    const int32_t input_zero = (int32_t){{ input_zero_expr }};
    const {{ compute_type }} output_zero = ({{ compute_type }}){{ output_zero_expr }};
{% if not output_wrap %}
    const {{ compute_type }} output_min = ({{ compute_type }}){{ min_literal }};
    const {{ compute_type }} output_max = ({{ compute_type }}){{ max_literal }};
    /* ONNX Runtime quantizes with the floored reciprocal of the output scale. */
    const {{ compute_type }} output_inv_scale = {{ scalar_fn(SF.FLOOR, compute_dtype) }}(({{ compute_type }})1 / output_scale_value);
{% endif %}
{% call axis_loops.loops(nest.loop_vars, nest.loop_sizes) %}
{{ compute_type }} max_value = {{ dequantized(nest.first_index) }};
{% call axis_loops.loops(nest.reduce_vars, nest.reduce_sizes, nest.after_first_starts) %}
{{ compute_type }} value = {{ dequantized(nest.index) }};
max_value = {{ scalar_fn(SF.MAXIMUM, compute_dtype) }}(max_value, value);
{% endcall %}
{{ compute_type }} sum = ({{ compute_type }})0;
{% call axis_loops.loops(nest.reduce_vars, nest.reduce_sizes) %}
{{ compute_type }} value = {{ dequantized(nest.index) }};
sum += {{ scalar_fn(SF.EXP, compute_dtype) }}(value - max_value);
{% endcall %}
{% call axis_loops.loops(nest.reduce_vars, nest.reduce_sizes) %}
{{ compute_type }} value = {{ dequantized(nest.index) }};
{{ compute_type }} exp_value = {{ scalar_fn(SF.EXP, compute_dtype) }}(value - max_value);
{% if output_wrap and output_is_signed %}
{{ compute_type }} scaled = (exp_value / sum) / output_scale_value + output_zero;
int32_t quantized = (int32_t){{ scalar_fn(SF.LLRINT, compute_dtype) }}(scaled);
uint8_t wrapped_u8 = (uint8_t)(quantized + 128);
int8_t wrapped_i8 = (int8_t)((int32_t)wrapped_u8 - 128);
{{ output }}{{ nest.index }} = ({{ output_c_type }})wrapped_i8;
{% elif output_wrap %}
{{ compute_type }} scaled = (exp_value / sum) / output_scale_value + output_zero;
int32_t quantized = (int32_t){{ scalar_fn(SF.LLRINT, compute_dtype) }}(scaled);
uint8_t wrapped_u8 = (uint8_t)quantized;
{{ output }}{{ nest.index }} = ({{ output_c_type }})wrapped_u8;
{% else %}
{{ compute_type }} scaled = (exp_value * output_inv_scale) / sum;
{{ compute_type }} rounded = {{ scalar_fn(SF.NEARBYINT, compute_dtype) }}(scaled) + output_zero;
rounded = {{ scalar_fn(SF.MAXIMUM, compute_dtype) }}(rounded, output_min);
rounded = {{ scalar_fn(SF.MINIMUM, compute_dtype) }}(rounded, output_max);
{{ output }}{{ nest.index }} = ({{ output_c_type }})rounded;
{% endif %}
{% endcall %}
{% endcall %}
}
