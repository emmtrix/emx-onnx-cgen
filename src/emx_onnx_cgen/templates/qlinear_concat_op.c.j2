{% import "axis_loops.c.j2" as axis_loops %}
EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
{% for p in unused_zero_params %}
    (void){{ p }};
{% endfor %}
    const {{ compute_type }} y_scale_val = ({{ compute_type }}){{ y_scale_expr }};
    const {{ compute_type }} y_zero_val = ({{ compute_type }}){{ y_zero_expr }};
{% for copy in copies %}
{% call axis_loops.loops(copy.part.loop_vars, copy.part.loop_sizes) %}
{{ compute_type }} real_val = ({{ compute_type }})((int32_t){{ copy.input }}{{ copy.part.part_index }} - (int32_t)({{ copy.zero_expr }})) * ({{ compute_type }})({{ copy.scale_expr }});
{{ compute_type }} scaled = real_val / y_scale_val + y_zero_val;
{{ compute_type }} rounded = {{ scalar_fn(SF.NEARBYINT, compute_dtype) }}(scaled);
rounded = {{ scalar_fn(SF.MAXIMUM, compute_dtype) }}(rounded, ({{ compute_type }}){{ min_literal }});
rounded = {{ scalar_fn(SF.MINIMUM, compute_dtype) }}(rounded, ({{ compute_type }}){{ max_literal }});
{{ output_name }}{{ copy.part.whole_index }} = ({{ output_c_type }})rounded;
{% endcall %}
{% endfor %}
}
