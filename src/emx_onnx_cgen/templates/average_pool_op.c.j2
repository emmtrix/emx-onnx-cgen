{# Plain sum over the window. Bounds checks only in the spatial dimensions where an input index
   can leave the input; the window position count (the divisor) is counted only where it is not
   the kernel size. #}
{% set runtime_count = (true in bounds_checks) and not (count_include_pad and (true not in pad_checks)) %}
EMX_NODE_FN void {{ op_name }}({{ dim_args }}{{ params | join(', ') }}) {
    for (idx_t n = 0; n < {{ batch }}; ++n) {
        for (idx_t c = 0; c < {{ channels }}; ++c) {
            {% for dim in range(spatial_rank) %}
            for (idx_t {{ out_indices[dim] }} = 0; {{ out_indices[dim] }} < {{ out_spatial[dim] }}; ++{{ out_indices[dim] }}) {
            {% endfor %}
                {{ c_type }} acc = {{ zero_literal }};
{% if runtime_count %}
                idx_t count = 0;
{% endif %}
                {% for dim in range(spatial_rank) %}
                for (idx_t {{ kernel_indices[dim] }} = 0; {{ kernel_indices[dim] }} < {{ kernel_shape[dim] }}; ++{{ kernel_indices[dim] }}) {
                {% endfor %}
                    {% for dim in range(spatial_rank) %}
                    const idx_t {{ in_indices[dim] }} = {{ out_indices[dim] }} * {{ strides[dim] }} + {{ kernel_indices[dim] }} * {{ dilations[dim] }} - {{ pads_begin[dim] }};
                    {% endfor %}
{% if true in bounds_checks %}
                    if ({% for dim in range(spatial_rank) if bounds_checks[dim] %}{{ in_indices[dim] }} >= 0 && {{ in_indices[dim] }} < {{ in_spatial[dim] }}{% if not loop.last %} && {% endif %}{% endfor %}) {
{% endif %}
                        acc += {{ input0 }}[n][c]{% for dim in range(spatial_rank) %}[{{ in_indices[dim] }}]{% endfor %};
{% if runtime_count and not count_include_pad %}
                        count += 1;
{% endif %}
{% if true in bounds_checks %}
                    }
{% endif %}
{% if runtime_count and count_include_pad %}
                    if ({% for dim in range(spatial_rank) if pad_checks[dim] %}{{ in_indices[dim] }} < {{ in_spatial[dim] }} + {{ pads_end[dim] }}{% if not loop.last %} && {% endif %}{% endfor %}) {
                        count += 1;
                    }
{% endif %}
                {% for dim in range(spatial_rank) %}
                }
                {% endfor %}
{% if runtime_count %}
                {{ output }}[n][c]{% for dim in range(spatial_rank) %}[{{ out_indices[dim] }}]{% endfor %} = count ? acc / ({{ c_type }})count : {{ zero_literal }};
{% else %}
                {{ output }}[n][c]{% for dim in range(spatial_rank) %}[{{ out_indices[dim] }}]{% endfor %} = acc / ({{ c_type }}){{ kernel_size }};
{% endif %}
            {% for dim in range(spatial_rank) %}
            }
            {% endfor %}
        }
    }
}
